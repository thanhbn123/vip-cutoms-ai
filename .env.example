# Copy to .env for local use. Never commit .env. No real secrets belong in this file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://vip_customs:vip_customs@localhost:5432/vip_customs
# Required outside development (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
AI_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./local-data/uploads
CORS_ORIGINS=http://localhost:5173
# docker compose only
POSTGRES_USER=vip_customs
POSTGRES_PASSWORD=
POSTGRES_DB=vip_customs
POSTGRES_HOST_PORT=5432   # host-side port for the compose postgres (use e.g. 55432 if 5432 is taken locally)
