# Copy to .env for local use. Never commit .env. No real secrets belong in this file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://vip_customs:vip_customs@localhost:5432/vip_customs
# Required outside development (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Runtime mode (G18): demo | limited | full. `full` refuses to start with mock providers or without production config.
APP_MODE=demo
# Git SHA of the running build, reported by /ready (compose sets it from IMAGE_TAG).
RELEASE_SHA=
# AI providers (G18). AI_PROVIDER is the default for all four capabilities; override per capability if needed.
# Implemented: mock | http-llm. http-llm needs the three AI_PROVIDER_* values below (owner input B-01); keep them EMPTY here.
AI_PROVIDER=mock
DOCUMENT_OCR_PROVIDER=
DOCUMENT_AI_PROVIDER=
HS_AI_PROVIDER=
COPILOT_PROVIDER=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_TIMEOUT_SECONDS=30
# Login throttling (G18D): failed attempts per client IP / e-mail inside the window → 429 for the lockout
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
AI_MAX_RETRIES=2
AI_DAILY_BUDGET_USD=
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./local-data/uploads
CORS_ORIGINS=http://localhost:5173
# docker compose only
POSTGRES_USER=vip_customs
POSTGRES_PASSWORD=
POSTGRES_DB=vip_customs
POSTGRES_HOST_PORT=5432   # host-side port for the compose postgres (use e.g. 55432 if 5432 is taken locally)
