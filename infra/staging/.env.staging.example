# Staging environment template. Copy to infra/staging/.env ON THE STAGING HOST, fill it in, chmod 600.
#   cp infra/staging/.env.staging.example infra/staging/.env && chmod 600 infra/staging/.env
# NEVER commit infra/staging/.env — it is git-ignored. See docs/STAGING_SECRETS.md for who provides what.
# No real secret belongs in THIS file; every value below is a placeholder or a safe default.

APP_ENV=staging

# --- database (never published outside the compose network) -------------------
POSTGRES_USER=vip_customs
POSTGRES_DB=vip_customs
# Generate ON THE HOST, >= 32 chars:  python3 -c "import secrets;print(secrets.token_urlsafe(36))"
POSTGRES_PASSWORD=

# --- application -------------------------------------------------------------
# Required outside development, >= 32 chars. The API refuses to start without it.
# Generate ON THE HOST:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Staging boots with the mock AI provider. Real providers are a later gate.
AI_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/uploads

# --- public addressing -------------------------------------------------------
# Hostname the stack is reached on; CORS allow-list is derived from PUBLIC_WEB_ORIGIN.
PUBLIC_HOST=staging.example.internal
PUBLIC_WEB_ORIGIN=https://staging.example.internal

# TLS_MODE selects how the stack's own Caddy terminates TLS:
#   internal  self-signed certificate (private staging, no public DNS needed)
#   acme      Let's Encrypt via ACME — REQUIRES this stack to own host ports 80 and 443
#   <email>   same as acme, with a contact address registered at the ACME CA
#   off       plain HTTP — TLS is terminated by an upstream/shared reverse proxy
TLS_MODE=internal

# Host-side ports for the stack's proxy. Defaults are 80/443, which only work if nothing
# else on the host owns them. On a shared host, bind to loopback high ports and let the
# shared proxy forward to them, e.g.:
#   PUBLIC_HTTP_PORT=127.0.0.1:18100
#   PUBLIC_HTTPS_PORT=127.0.0.1:18543
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# --- acceptance only ---------------------------------------------------------
# Password for the seeded demo tenant used by scripts/staging/acceptance.sh (>= 10 chars).
# Demo data only. Delete the demo users after acceptance.
SEED_DEMO_PASSWORD=

# Set automatically by scripts/staging/deploy.sh to the 12-char deploy SHA.
IMAGE_TAG=latest
