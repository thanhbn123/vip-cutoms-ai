# Production environment template — NOT a deployment. Copy to infra/production/.env ON THE
# PRODUCTION HOST, fill it in, chmod 600:
#   cp infra/production/.env.production.example infra/production/.env && chmod 600 infra/production/.env
# NEVER commit infra/production/.env — `.env*` is git-ignored. See docs/PRODUCTION_READINESS.md.
# No real secret belongs in THIS file; every value below is a placeholder or a safe default.
#
# ┌──────────────────────────────────────────────────────────────────────────────────────────┐
# │ SCOPE LIMIT (product rule #7). This build has no customs-system adapter of any kind.     │
# │ Deploying it to production yields an INTERNAL DRAFTING TOOL only: it produces versioned, │
# │ watermarked internal drafts and never transmits a declaration to any customs system.     │
# │ The knowledge datasets it ships are DEMO — NON-AUTHORITATIVE — NOT FOR CUSTOMS FILING.   │
# │ Running it as the system of record for real filings requires owner decisions B-01 and    │
# │ B-02 (see docs/PRODUCTION_READINESS.md) — it is NOT merely a configuration change.       │
# └──────────────────────────────────────────────────────────────────────────────────────────┘

APP_ENV=production

# --- database (never published outside the compose network) -------------------
POSTGRES_USER=vip_customs
POSTGRES_DB=vip_customs
# Generate ON THE HOST, >= 32 chars:  python3 -c "import secrets;print(secrets.token_urlsafe(36))"
POSTGRES_PASSWORD=

# --- application -------------------------------------------------------------
# Required outside development, >= 32 chars. The API REFUSES TO START without it
# (verified: RuntimeError "APP_SECRET_KEY is required outside development").
# Generate ON THE HOST:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this value invalidates every issued token (all users must log in again).
APP_SECRET_KEY=

# AI provider. `mock` is the ONLY provider implemented in this build. Any other value makes
# the gateway fail closed and /ready return 503, so the stack cannot serve traffic with a
# half-configured provider. Do not invent a value here: adding a real OCR/LLM provider is a
# code change behind app/ai/base.py:AIProvider plus owner decision B-01.
AI_PROVIDER=mock

# Object storage. `local` is the ONLY provider implemented in this build; anything else raises
# RuntimeError("storage provider '<name>' not available in this build"). LOCAL_STORAGE_DIR is a
# named Docker volume mount — it MUST be included in backups alongside the database.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/uploads

# Maximum accepted upload size in bytes (default 20 MiB). Enforced server-side (413).
MAX_UPLOAD_BYTES=20971520

# --- public addressing -------------------------------------------------------
# Hostname the stack is reached on. CORS allow-list is derived from PUBLIC_WEB_ORIGIN, so it
# must be the exact scheme+host users browse to, with no trailing slash.
PUBLIC_HOST=app.example.com
PUBLIC_WEB_ORIGIN=https://app.example.com

# TLS_MODE selects how the stack's own Caddy terminates TLS:
#   internal  self-signed certificate (private network only)
#   acme      Let's Encrypt via ACME — REQUIRES this stack to own host ports 80 and 443
#   <email>   same as acme, with a contact address registered at the ACME CA
#   off       plain HTTP on the published port — TLS terminated by an upstream/shared proxy
# PRODUCTION DEFAULT IS `acme`: a production deployment should own its own certificate
# lifecycle. Use `off` only on a host where a reverse proxy you control terminates TLS, and
# only with PUBLIC_HTTP_PORT bound to loopback (see owner decision B-06).
TLS_MODE=acme

# Host-side ports for the stack's proxy. 80/443 only work if nothing else owns them.
# Behind a shared proxy, bind to loopback high ports instead, e.g.
#   PUBLIC_HTTP_PORT=127.0.0.1:18200
#   PUBLIC_HTTPS_PORT=127.0.0.1:18643
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# --- release pinning --------------------------------------------------------
# Set by the deploy procedure to the 12-char git SHA being released. Never `latest` in
# production: an unpinned tag makes a rollback ambiguous.
IMAGE_TAG=

# --- backup -----------------------------------------------------------------
# Destination for scripts/production/backup.sh. Must be on a different volume than the
# database, and replicated off-host (the script does not do off-host copies itself).
BACKUP_DIR=/var/backups/vip-customs
# Daily dumps to retain locally. Off-host retention is the operator's responsibility.
BACKUP_RETENTION_DAYS=14

# --- deliberately absent ----------------------------------------------------
# SEED_DEMO_PASSWORD is NOT part of a production configuration. scripts/seed_demo.py refuses
# to run when APP_ENV is not development/test (verified), so demo users cannot be created in
# production at all. There is no variable here for a customs-system endpoint, credential or
# certificate, because no such integration exists in this build.
